// Zarhak Inventory Management — Phase 1 schema
// See /Users/hardik.parikh/.claude/plans/i-am-attaching-a-streamed-thimble.md for the design rationale.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth — plain email/password (Auth.js Credentials provider, JWT sessions).
// No OAuth/Account/Session tables needed since there's no external identity
// provider to link; access control is the Role gate below (new sign-ups land as
// PENDING until an admin assigns a role), not an email-domain restriction.
// ---------------------------------------------------------------------------

enum Role {
  PENDING
  ADMIN
  PROCUREMENT
  STORES
  REVIEWER
  SALES
  PRODUCTION
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(PENDING)
  createdAt    DateTime @default(now())

  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------------------------------------------------------
// Master / reference data
// ---------------------------------------------------------------------------

// Mirrors the AppSheet "Dropdown and Master List" mega-table's self-service-append
// behavior: any user can add a new allowed value with no schema migration needed.
enum LookupDomain {
  PO_TYPE
  PO_GRADE
  TYPE_OF_STEEL
  ITEM_TYPE
  ITEM_NAME
  VENDOR_NAME
  MILL
  WEB_COATING
  COATING
  WEB_TEMPER
  TEMPER
  GRADE
  FINISH
  ANNEALED_TYPE
  COIL_ID
  PRODUCT_CATEGORY
  PURCHASE_TYPE
  DELIVERY_LOCATION
  STATE_NAME
  UNLOADED_BY
  REVIEWED_BY
  BAY_LOCATION
  SALES_TYPE
  FACTORY_LOCATION
  END_USE
  OPERATOR
  ASSISTANT_OPERATOR
  ORIGIN
  COIL_FEEDING_OPERATOR
  ORDER_CATEGORY
  SHIP_TO
}

model LookupValue {
  id        String       @id @default(cuid())
  domain    LookupDomain
  value     String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  createdBy String?

  @@unique([domain, value])
  @@index([domain])
}

model Customer {
  id          String   @id @default(cuid())
  alpha       String?
  legalName   String // "Consignee/Buyer" in the source app
  displayName String // packing-list-facing name (user-requested addition)
  address     String?
  gstin       String?
  zsplCode    String?
  location    String?
  stateName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  masterStocks         MasterStock[]
  cuttingOrders        CuttingOrderSummary[]
  slittingOrders       SlittingOrderSummary[]
  tradingSummaries     TradingSummary[]
  dispatchesAsCustomer DispatchSummary[]       @relation("DispatchCustomer")
  dispatchesAsBuyer    DispatchSummary[]       @relation("DispatchBuyer")
  dispatchesAsConsignee DispatchSummary[]      @relation("DispatchConsignee")

  @@index([legalName])
}

// Two independent 1:1 lookups, NOT one joint (coating, temper) -> (webCoating,
// webTemper) mapping. Confirmed against the real production data and the source
// app's own formulas: Web Coating = LOOKUP(Coating in "Dropdown and Master List"),
// Web Temper = LOOKUP(Temper in "Dropdown and Master List") — two separate
// single-column lookups that happen to sit in adjacent sheet columns, not a composite
// key. Modeled here as two small tables instead of one to match that reality.
model CoatingMapping {
  coating    String @id
  webCoating String
}

model TemperMapping {
  temper    String  @id
  webTemper Decimal @db.Decimal(10, 3)
}

// ---------------------------------------------------------------------------
// Atomic sequence counters (replace AppSheet's racy MAX()+1 pattern)
// ---------------------------------------------------------------------------

model PoSequence {
  fy      String @id
  lastSeq Int    @default(0)
}

model SalesSequence {
  fy      String @id
  lastSeq Int    @default(0)
}

model ZsplSequence {
  key     String @id @default("global")
  lastSeq Int    @default(0)
}

// Powers the Dispatch wizard's auto-assigned DO number (ZSPL/DO/{fy}/{seq}) — replaces
// the old free-text-per-form DO number entry with a single guaranteed-unique sequence.
model DoSequence {
  fy      String @id
  lastSeq Int    @default(0)
}

// ---------------------------------------------------------------------------
// Procurement
// ---------------------------------------------------------------------------

enum POStatus {
  OPEN
  IN_PROCESS
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  poNumber      String   @unique
  poSeq         Int
  fy            String
  poDate        DateTime @default(now())
  orderType     String   @default("PO")
  poType        String
  poGrade       String
  typeOfSteel   String
  vendorName    String
  shipTo        String
  mill          String
  orderCategory String
  status        POStatus @default(OPEN)
  remark        String?
  createdAt     DateTime @default(now())
  createdBy     String
  updatedAt     DateTime @updatedAt

  items         ItemDetail[]
  inwardRecords InwardRecord[]

  @@index([fy])
  @@index([status])
}

enum ItemType {
  ETP
  TFS
  TMBP
  A
  OTHER
}

enum ItemStatus {
  PENDING
  MATCHED
  RECEIVED
}

model ItemDetail {
  id              String     @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // App-computed composite match key (see lib/matching.ts) — replaces the source
  // app's manual, error-prone "Concatenate Item details" field.
  concatenateKey String

  itemType        ItemType
  thickness       Decimal    @db.Decimal(10, 3)
  width           Decimal    @db.Decimal(10, 3)
  length          Decimal?   @db.Decimal(10, 3) // null for coil-form items (only bundles have a cut length)
  coating         String
  temper          String
  finish          String
  grade           String
  annealedType    String?
  vendorIdNo      String?
  qtyMt           Decimal    @db.Decimal(12, 3)
  coilId          String?
  // Historical data commonly leaves these blank (confirmed in the real production
  // export) — nullable rather than rejecting a decade of real rows on import.
  vendorName      String?
  steelType       String?
  purchasePrice   Decimal?   @db.Decimal(12, 2)
  productCategory String?
  itemRemark      String?
  itemStatus      ItemStatus @default(PENDING)
  bundleCoil      String // app-computed: "B" if coilId set else "C"
  itemName        String // app-computed from itemType map
  sleeveType      String?
  endUse          String?
  poReportUrl     String? // placeholder only — no PDF generation in Phase 1
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  inwardMatches InwardRecord[]

  @@index([purchaseOrderId])
  @@index([concatenateKey])
}

// ---------------------------------------------------------------------------
// Goods receipt (Inward)
// ---------------------------------------------------------------------------

model InwardRecord {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  matchedItemId String?
  matchedItem   ItemDetail? @relation(fields: [matchedItemId], references: [id])

  concatenatedId String // same recipe as ItemDetail.concatenateKey

  dispatchDate DateTime?
  itemType     String
  grade        String
  thickness    Decimal   @db.Decimal(10, 3)
  width        Decimal   @db.Decimal(10, 3)
  length       Decimal?  @db.Decimal(10, 3)
  mill         String
  coating      String
  temper       String
  finish       String

  netWt      Decimal  @db.Decimal(12, 3)
  coilLength Decimal? @db.Decimal(10, 3)
  noOfSheets Int?
  coilId     String?
  vendorName String
  vehicleNo  String
  vendorIdNo String?
  heatNo     String?
  millTc     String?

  // app-computed via CoatingTemperMapping at create — nullable since the lookup can
  // legitimately fail to resolve (no mapping row for that coating yet)
  webCoating String?
  webTemper  Decimal? @db.Decimal(10, 3)

  iGrWt         Decimal? @db.Decimal(12, 3) // filled by Stores during physical unloading, not at CSV import time
  inwardRemarks String?
  bayLocation   String?
  purchaseType  String

  unloadedBy String?
  reviewBy   String?

  unloadTime       DateTime? // app-set once, on first unloadedBy null->set transition
  unloadedInwardNo String?

  vendorInvoiceNo String?
  vendorInvDate   DateTime?

  bundleCoil String
  seq        Int?
  zsplId     String  @unique
  annealedType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masterStockRows MasterStock[]

  @@index([purchaseOrderId])
  @@index([matchedItemId])
  @@index([reviewBy])
}

// ---------------------------------------------------------------------------
// Master Stock — the central inventory/allocation pool
// ---------------------------------------------------------------------------

enum MasterStockStatus {
  AVAILABLE
  OFFERED
  BOOKED
  SOLD
  CANCELLED
}

model MasterStock {
  id       String        @id @default(cuid())
  inwardId String?
  inward   InwardRecord? @relation(fields: [inwardId], references: [id])

  zsplId       String
  vendorName   String
  purchaseType String
  unloadDate   DateTime

  itemType  String
  mill      String
  grade     String
  thickness Decimal  @db.Decimal(10, 3)
  width     Decimal  @db.Decimal(10, 3)
  length    Decimal? @db.Decimal(10, 3)

  webCoating String?
  coating    String
  webTemper  Decimal? @db.Decimal(10, 3)
  temper     String
  finish     String

  inwardRemarks String?
  coilId        String?

  netWt      Decimal @db.Decimal(12, 3) // relabeled "I Gr Wt" per the source app's own note
  noOfSheets String?
  itemForm   String

  purchasePrice Decimal @db.Decimal(12, 2) // copied at creation, not re-derived live

  salesDate             DateTime?
  customerId            String?
  customer              Customer? @relation(fields: [customerId], references: [id])
  customerPoNo          String?
  customerPoDate        DateTime?
  endUse                String?
  productionWeight      Decimal?  @db.Decimal(12, 3)
  salePrice             Decimal?  @db.Decimal(12, 2)
  salesRemark           String?
  requestedDeliveryDate DateTime?
  deliveryLocation      String?
  salesType             String? // drives Phase 2 routing: Cutting/Slitting/Trading
  actualDispatchDate    DateTime?

  availableWeight Decimal @db.Decimal(12, 3)
  noOfSplits      Int     @default(0)

  originalMasterStockId String?
  originalMasterStock   MasterStock?  @relation("Splits", fields: [originalMasterStockId], references: [id])
  splitChildren         MasterStock[] @relation("Splits")

  status        MasterStockStatus @default(AVAILABLE)
  salesPoNumber String?

  serialNumber Int?
  annealed     String?
  coilLength   Decimal? @db.Decimal(10, 3)
  bayLocation  String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  cuttingOrders    CuttingOrderSummary[]
  slittingOrders   SlittingOrderSummary[]
  tradingSummaries TradingSummary[]

  @@index([status])
  @@index([customerId])
  @@index([originalMasterStockId])
  @@index([zsplId])
}

model StatusHistory {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  fromStatus String?
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())
  note       String?

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Sequences used by the Phase 2 sales-order/work-order numbering below.
// ---------------------------------------------------------------------------

model WorkOrderSequence {
  year    Int    @id
  lastSeq Int    @default(0)
}

// ---------------------------------------------------------------------------
// Phase 2 — Cutting production
// Master Stock status -> SOLD with salesType "Cutting" auto-creates one of these
// (see transitionMasterStock). Flow: fill production-planning fields -> approve
// (-> Daily Cutting queue) -> Machine Production + Quality Data entries as the coil
// is actually cut -> Bundlewise Data rows (lettered A/B/C.., "XX" reject / "YY" scrap)
// -> Finished Goods Cutting Summary -> selected into Dispatch Summary.
// ---------------------------------------------------------------------------

enum ProductionStatus {
  INPUT_CUT_LENGTH
  PENDING_PRODUCTION
  COMPLETED
}

model CuttingOrderSummary {
  id             String   @id @default(cuid())
  workOrderNo    String?
  salesOrderNo   String?
  salesOrderDate DateTime @default(now())

  masterStockId String
  masterStock   MasterStock @relation(fields: [masterStockId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  zsplId    String
  itemType  String
  grade     String
  mill      String
  thickness Decimal  @db.Decimal(10, 3)
  width     Decimal  @db.Decimal(10, 3)
  length    Decimal? @db.Decimal(10, 3) // cut length — required before production planning
  coating   String
  temper    String
  finish    String

  netWt        Decimal  @db.Decimal(12, 3)
  productionWt Decimal? @db.Decimal(12, 3)
  soldPrice    Decimal? @db.Decimal(12, 2)
  salesRemark  String?

  requestedDeliveryDate DateTime?
  productionPlanDate    DateTime?
  productionStatus      ProductionStatus @default(INPUT_CUT_LENGTH)

  packingType         String?
  noOfSheetsPerPallet Decimal? @db.Decimal(10, 2)
  wtPerBundle         Decimal? @db.Decimal(10, 3)
  noOfBundles         Int?     @default(1)
  productionSequence  Int?

  approvedBy String?
  approvedAt DateTime?

  bayLocation String?
  coilId      String?
  coilLength  Decimal? @db.Decimal(10, 3)

  availableWeight Decimal @db.Decimal(12, 3)
  noOfSplits      Int     @default(0)

  originalCuttingOrderId String?
  originalCuttingOrder   CuttingOrderSummary?  @relation("CuttingSplits", fields: [originalCuttingOrderId], references: [id])
  splitChildren          CuttingOrderSummary[] @relation("CuttingSplits")

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  machineProductions MachineProduction[]
  qualityData        QualityData[]
  bundlewiseData     BundlewiseData[]
  dispatchSummaries  DispatchSummary[]

  @@index([productionStatus])
  @@index([masterStockId])
  @@index([originalCuttingOrderId])
}

model MachineProduction {
  id              String              @id @default(cuid())
  cuttingOrderId  String
  cuttingOrder    CuttingOrderSummary @relation(fields: [cuttingOrderId], references: [id])

  shift               String?
  mainOperator        String?
  assistantOperator   String?
  coilFeedingOperator String?

  setupStartTime      DateTime?
  productionStartTime DateTime?
  productionEndTime   DateTime? // filled -> triggers move to "Completed" / FG Cutting Summary

  feedingType String?

  actualNetWeight  Decimal? @db.Decimal(12, 3)
  actualWidth      Decimal? @db.Decimal(10, 3)
  actualThickness  Decimal? @db.Decimal(10, 3)
  tolerance        Decimal? @db.Decimal(10, 3)
  squareness       String?
  bowEntry         Decimal? @db.Decimal(10, 3)
  bowExit          Decimal? @db.Decimal(10, 3)
  speed            String?

  palletReady Boolean @default(false)
  breakdown        Boolean @default(false)
  breakdownRemark  String?
  quality          Boolean @default(false)
  qualityRemark    String?

  actualCoilLength  Decimal? @db.Decimal(10, 3)
  totalSheets       Int?
  totalPrimeSheets  Int?
  totalRejectSheets Int?
  pinhole           Int?
  undergauge        String?
  overgauge         String?
  visualDefects     String?
  partCoil          String?
  downtime          Decimal? @db.Decimal(10, 2)
  palletRemark      String?

  createdAt DateTime @default(now())
  createdBy String

  @@index([cuttingOrderId])
}

model QualityData {
  id             String              @id @default(cuid())
  cuttingOrderId String
  cuttingOrder   CuttingOrderSummary @relation(fields: [cuttingOrderId], references: [id])

  hardness               Decimal? @db.Decimal(10, 2)
  actualTemper           String?
  cuppingValue           Decimal? @db.Decimal(10, 3)
  sheetSize              Decimal? @db.Decimal(10, 2)
  bow                    String?
  squareness             String?
  defectsObserved        String?
  underDeviationApproval Boolean  @default(false)
  loadPictureUrl         String?

  createdAt DateTime @default(now())
  createdBy String

  @@index([cuttingOrderId])
}

enum BundleStatus {
  PENDING
  APPROVED
}

model BundlewiseData {
  id             String              @id @default(cuid())
  cuttingOrderId String
  cuttingOrder   CuttingOrderSummary @relation(fields: [cuttingOrderId], references: [id])

  bundleIdNo String // lettered A, B, C… or "XX" reject / "YY" scrap placeholder bundles

  cutLength     Decimal?  @db.Decimal(10, 3)
  coilNetWt     Decimal?  @db.Decimal(12, 3)
  productionDate DateTime @default(now())
  preparedBy    String?
  reviewedBy    String?
  noOfSheets    Int?
  palletWeight  Decimal?  @db.Decimal(10, 3)
  grossBundleWt Decimal?  @db.Decimal(12, 3)
  netBundleWt   Decimal?  @db.Decimal(12, 3) // gross - pallet

  status BundleStatus @default(PENDING) // Approved -> eligible for Finished Goods / Dispatch

  availableWeight Decimal @db.Decimal(12, 3)
  noOfSplits      Int     @default(0)

  originalBundleId String?
  originalBundle   BundlewiseData?  @relation("BundleSplits", fields: [originalBundleId], references: [id])
  splitChildren    BundlewiseData[] @relation("BundleSplits")

  dispatchLocation String?
  doNumber         String?

  createdAt DateTime @default(now())
  createdBy String

  dispatchSummaries DispatchSummary[]

  @@index([cuttingOrderId])
  @@index([status])
  @@index([originalBundleId])
}

// ---------------------------------------------------------------------------
// Phase 2 — Slitting production (coil-based: slit widths/counts, no cut length)
// ---------------------------------------------------------------------------

enum SlittingProductionStatus {
  PENDING
  IN_PROCESS
  COMPLETED
}

model SlittingOrderSummary {
  id             String   @id @default(cuid())
  workOrderNo    String?
  salesOrderNo   String?
  salesOrderDate DateTime @default(now())

  masterStockId String
  masterStock   MasterStock @relation(fields: [masterStockId], references: [id])
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  zsplId    String
  itemType  String
  grade     String
  mill      String?
  thickness Decimal @db.Decimal(10, 3)
  width     Decimal @db.Decimal(10, 3)
  coating   String
  temper    String
  finish    String

  netWt        Decimal  @db.Decimal(12, 3)
  productionWt Decimal? @db.Decimal(12, 3)
  soldPrice    Decimal? @db.Decimal(12, 2)
  salesRemark  String?

  requiredDeliveryDate DateTime?

  slit1     Decimal? @db.Decimal(10, 3)
  slit2     Decimal? @db.Decimal(10, 3)
  slit3     Decimal? @db.Decimal(10, 3)
  slit4     Decimal? @db.Decimal(10, 3)
  noOfSlit1 Int?
  noOfSlit2 Int?
  noOfSlit3 Int?
  noOfSlit4 Int?

  productionPlanDate DateTime?
  vendorName         String?
  productionStatus   SlittingProductionStatus @default(PENDING)
  numberOfBundles    Int?

  jobWorkVendorName String?
  truckNo           String?

  slittingCustomerMasterSerial1 String?
  slittingCustomerMasterSerial2 String?
  slittingCustomerMasterSerial3 String?
  slittingCustomerMasterSerial4 String?

  bayLocation String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  slittingProductionData SlittingProductionData[]
  dispatchSummaries      DispatchSummary[]

  @@index([productionStatus])
  @@index([masterStockId])
}

model SlittingProductionData {
  id              String               @id @default(cuid())
  slittingOrderId String
  slittingOrder   SlittingOrderSummary @relation(fields: [slittingOrderId], references: [id])

  bundleIdNo    String // lettered a, b, c… per bundle produced
  slitWidth     Decimal? @db.Decimal(10, 3)
  noOfSlitCoils Int?
  netWt         Decimal? @db.Decimal(12, 3)
  grossWt       Decimal? @db.Decimal(12, 3)

  availableWeight Decimal @db.Decimal(12, 3)
  noOfSplits      Int     @default(0)

  originalSlitId String?
  originalSlit   SlittingProductionData?  @relation("SlitSplits", fields: [originalSlitId], references: [id])
  splitChildren  SlittingProductionData[] @relation("SlitSplits")

  createdAt DateTime @default(now())
  createdBy String

  dispatchSummaries DispatchSummary[]

  @@index([slittingOrderId])
  @@index([originalSlitId])
}

model SlittingCustomerMaster {
  id                String  @id @default(cuid())
  thickness         Decimal @db.Decimal(10, 3)
  slittingSize      Decimal? @db.Decimal(10, 3)
  widthTolerance    String?
  noOfSlitPerPallet Int
  slitWt            String?
  slitCoilId        String?
  slitStrapingType  String?
  documentReference String?
  customerName      String?
  palletSize        String?
  remarks           String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 2 — Trading (simpler pass-through repackaging of Master Stock for resale)
// ---------------------------------------------------------------------------

model TradingSummary {
  id            String      @id @default(cuid())
  masterStockId String
  masterStock   MasterStock @relation(fields: [masterStockId], references: [id])
  salesOrderNo  String?
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])

  zsplId    String
  itemType  String
  grade     String
  mill      String?
  thickness Decimal  @db.Decimal(10, 3)
  width     Decimal  @db.Decimal(10, 3)
  length    Decimal? @db.Decimal(10, 3)
  coating   String
  temper    String
  finish    String

  noOfSheets  String?
  netWeight   Decimal  @db.Decimal(12, 3)
  grossWeight Decimal? @db.Decimal(12, 3)

  dispatchLocation String?
  doNo             String?
  doDate           DateTime?

  availableWeight Decimal @db.Decimal(12, 3)
  noOfSplits      Int     @default(0)

  originalTradingId String?
  originalTrading   TradingSummary?  @relation("TradingSplits", fields: [originalTradingId], references: [id])
  splitChildren     TradingSummary[] @relation("TradingSplits")

  itemForm    String?
  bayLocation String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt

  dispatchSummaries DispatchSummary[]

  @@index([masterStockId])
  @@index([originalTradingId])
}

// ---------------------------------------------------------------------------
// Phase 3 — Dispatch (consolidates finished goods from all 3 production paths,
// grouped by DO number) and reference data it depends on.
// ---------------------------------------------------------------------------

model Transporter {
  id    String  @id @default(cuid())
  name  String  @unique
  gstNo String?
}

model DispatchSummary {
  id String @id @default(cuid())

  cuttingBundleId      String?
  cuttingBundle        BundlewiseData?         @relation(fields: [cuttingBundleId], references: [id])
  slittingProductionId String?
  slittingProduction   SlittingProductionData? @relation(fields: [slittingProductionId], references: [id])
  tradingId            String?
  trading              TradingSummary?         @relation(fields: [tradingId], references: [id])
  cuttingOrderId        String?
  cuttingOrder          CuttingOrderSummary?   @relation(fields: [cuttingOrderId], references: [id])
  slittingOrderId       String?
  slittingOrder         SlittingOrderSummary?  @relation(fields: [slittingOrderId], references: [id])

  doNumber String
  doDate   DateTime @default(now())

  customerId String?
  customer   Customer? @relation("DispatchCustomer", fields: [customerId], references: [id])

  finalZsplId    String?
  itemType       String?
  thickness      Decimal? @db.Decimal(10, 3)
  width          Decimal? @db.Decimal(10, 3)
  cutLength      Decimal? @db.Decimal(10, 3)
  origin         String?
  coating        String?
  temper         String?
  finish         String?
  netWeight      Decimal? @db.Decimal(12, 3)
  grossWeight    Decimal? @db.Decimal(12, 3)
  numberOfSheets Int?
  bundleNetWeight Decimal? @db.Decimal(12, 3)
  remarks        String?
  dispatchStatus String  @default("Pending")

  buyerId     String?
  buyer       Customer? @relation("DispatchBuyer", fields: [buyerId], references: [id])
  consigneeId String?
  consignee   Customer? @relation("DispatchConsignee", fields: [consigneeId], references: [id])

  transporterName String?
  vehicleNumber   String?
  lorryWeight     Decimal? @db.Decimal(10, 2)

  packingListCreated Boolean @default(false)
  packingListUrl     String?

  createdAt DateTime @default(now())
  createdBy String

  @@index([doNumber])
  @@index([dispatchStatus])
}

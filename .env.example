# Postgres connection string. Use a Neon connection string in production; any local
# Postgres works for development (the adapter auto-detects Neon vs. plain Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/zarhak_dev?schema=public"

# Auth.js
AUTH_SECRET="generate-a-random-secret-for-production"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "1" to enable a dev-only credentials login (bypasses Google OAuth) for local
# testing without real Google OAuth credentials. Must never be enabled in production.
AUTH_DEV_LOGIN="0"

ZARHAK_WORKSPACE_DOMAIN="zarhak.com"

# Comma-separated list of extra emails allowed in besides @zarhak.com (e.g. the admin
# account used to manage the app).
AUTH_EXTRA_ALLOWED_EMAILS="tridgebusiness@gmail.com"

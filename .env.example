# Postgres connection string. Use a Neon connection string in production; any local
# Postgres works for development (the adapter auto-detects Neon vs. plain Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/zarhak_dev?schema=public"

# Auth.js — plain email/password (Credentials provider, JWT sessions). No OAuth
# provider or domain restriction; access is controlled by the Role gate instead (new
# sign-ups land as PENDING until an admin assigns a role in /masters/users).
AUTH_SECRET="generate-a-random-secret-for-production"

# Optional: password to give the seeded admin account when running prisma/seed.ts.
# Defaults to "ChangeMe123!" if unset — change it after first login.
SEED_ADMIN_PASSWORD=""
